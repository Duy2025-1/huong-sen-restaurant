# Root gitignore for Restaurant Management System

# Environment variables
.env
.env.*
!.env.example
*.env

# Dependencies
node_modules/
*/node_modules/

# Build artifacts
dist/
*/dist/
build/
*/build/

# SQLite databases & temp files
*.db
*.db-journal
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS
.DS_Store
Thumbs.db
.vscode/
.idea/
